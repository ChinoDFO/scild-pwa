# Cadena de conexión a PostgreSQL.
# Opción rápida sin instalar nada local: crea un proyecto gratis en
# https://neon.tech o https://supabase.com y pega aquí la connection string.
DATABASE_URL="postgresql://usuario:password@host:5432/scild?schema=public"

# --- Comprobantes de pago ---------------------------------------------------
# Dónde se guardan las capturas de los pagos. Es el MISMO valor que la PWA
# trae en VITE_FIREBASE_STORAGE_BUCKET (Firebase Console -> Storage). Si se
# deja vacío se intenta <project_id>.firebasestorage.app, que no es el nombre
# correcto en proyectos creados hace tiempo (esos son .appspot.com).
FIREBASE_STORAGE_BUCKET="scild-emergencia.firebasestorage.app"

# --- Ampliación de límite ---------------------------------------------------
# Lo que se le muestra al cliente en el chat con los administradores. Va aquí
# y no en el código para poder cambiar precio o cuenta sin volver a desplegar.
PAGO_BANCO="BBVA"
PAGO_CLABE="012345678901234567"
PAGO_TITULAR="Nombre de quien recibe"
PAGO_MONTO="$XXX MXN"
# Opcional: a dónde escribir si el pago no se puede hacer.
PAGO_CONTACTO="soporte@scild.mx"
