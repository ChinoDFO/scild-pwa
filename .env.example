# Cadena de conexión a PostgreSQL.
# Opción rápida sin instalar nada local: crea un proyecto gratis en
# https://neon.tech o https://supabase.com y pega aquí la connection string.
DATABASE_URL="postgresql://usuario:password@host:5432/scild?schema=public&connect_timeout=30"

# OJO con connect_timeout: Neon en plan gratis SUSPENDE la base cuando lleva
# unos minutos sin usarse, y despertarla tarda varios segundos. Prisma corta a
# los 5 por defecto, así que la primera petición después de un rato fallaba con
# "Can't reach database server" aunque todo estuviera bien. Con 30 la espera y
# ya. Se nota como una primera carga lenta (~8 s) y luego todo normal.

# ---- Correos de la tienda (scild-web) ----
# Cuenta de Gmail que manda los correos. Se usa una "contraseña de aplicación"
# (NO tu contraseña normal): myaccount.google.com -> Seguridad -> Verificación
# en 2 pasos (debe estar activa) -> Contraseñas de aplicaciones.
# Si GMAIL_USER / GMAIL_APP_PASSWORD están vacías no se manda nada: el correo
# se imprime en la consola del servidor (útil para probar).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# A dónde llega el aviso de "nuevo pedido". Si se deja vacío usa GMAIL_USER.
CORREO_ADMIN=
# Llave (cuenta de servicio) del proyecto de Firebase de la TIENDA, no el de la
# app de emergencia: Firebase Console de scild-web -> Configuración del
# proyecto -> Cuentas de servicio -> "Generar nueva clave privada".
PEDIDOS_FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-pedidos-service-account.json
