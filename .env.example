# Cadena de conexión a PostgreSQL.
# Opción rápida sin instalar nada local: crea un proyecto gratis en
# https://neon.tech o https://supabase.com y pega aquí la connection string.
DATABASE_URL="postgresql://usuario:password@host:5432/scild?schema=public&connect_timeout=30"

# OJO con connect_timeout: Neon en plan gratis SUSPENDE la base cuando lleva
# unos minutos sin usarse, y despertarla tarda varios segundos. Prisma corta a
# los 5 por defecto, así que la primera petición después de un rato fallaba con
# "Can't reach database server" aunque todo estuviera bien. Con 30 la espera y
# ya. Se nota como una primera carga lenta (~8 s) y luego todo normal.
