// Modelo de datos del backend de SCILD Emergencia.
// Users/Groups/Devices/Alerts/Messages/Notifications/DeviceEvents/
// DeviceConfigurations/AuditLogs, tal como se definió en la propuesta técnica.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum DeviceStatus {
  ONLINE
  IRREGULAR
  OFFLINE
  EMERGENCY
  MAINTENANCE
}

enum AlertSource {
  DEVICE
  APP
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum DeviceEventType {
  HEARTBEAT
  PANIC
  STATUS_CHANGE
  CONFIG_UPDATE
  CONNECTED
  DISCONNECTED
}

// Solicitud de ampliación de límite: el cliente paga por transferencia y un
// administrador de la plataforma la confirma a mano.
enum PaymentStatus {
  ABIERTA // esperando que pague y mande su comprobante
  EN_REVISION // ya mandó la captura, falta que la revisemos
  APROBADA
  RECHAZADA
  CANCELADA // el propio cliente la dio de baja
}

enum PaymentAuthor {
  CLIENTE
  SOPORTE
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// La identidad y la contraseña viven en Firebase Auth. Este modelo solo
// guarda el perfil y enlaza con Firebase mediante firebaseUid.
model User {
  id              String   @id @default(uuid())
  firebaseUid     String   @unique
  email           String   @unique
  displayName     String?
  phone           String?
  // Administrador de la plataforma (nosotros), no de un grupo. Es quien ve
  // la lista de solicitudes de pago y confirma los depósitos. Se prende a
  // mano en la base: no hay forma de dárselo a sí mismo desde la app.
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships      GroupMember[]
  devices          Device[]         @relation("DeviceOwner")
  // Botones de los que es titular (el código de la caja se valida 2 veces).
  titularidades    DeviceHolder[]
  // Acceso completo que le regaló un titular, y los que él ha regalado.
  accesoRecibido   AccessGrant[]    @relation("AccesoRecibido")
  accesosOtorgados AccessGrant[]    @relation("AccesoOtorgado")
  messages         Message[]
  alertsCreated    Alert[]          @relation("AlertCreatedBy")
  notifications    Notification[]
  pushTokens       PushToken[]
  auditLogs        AuditLog[]
  solicitudes      PaymentRequest[] @relation("SolicitanteDelPago")
  pagosRevisados   PaymentRequest[] @relation("RevisorDelPago")
  mensajesDePago   PaymentMessage[]

  @@index([email])
}

model Group {
  id         String   @id @default(uuid())
  name       String
  address    String?
  latitude   Float?
  longitude  Float?
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members  GroupMember[]
  devices  Device[]
  alerts   Alert[]
  messages Message[]
}

model GroupMember {
  id           String   @id @default(uuid())
  userId       String
  groupId      String
  role         Role     @default(MEMBER)
  joinedAt     DateTime @default(now())
  // Hasta dónde leyó el chat de este grupo. Con esto se sabe cuántos
  // mensajes trae sin leer y si el aviso push dice el mensaje o
  // "3 mensajes nuevos".
  lastReadAt   DateTime @default(now())
  // Cada botón vinculado a un grupo da cupo para 10 personas. Esto dice de
  // qué botón sale el lugar que ocupa esta membresía, que es lo que permite
  // contar cuántos le quedan a cada uno: cuando un botón agota sus 10, la
  // única forma de meter más gente es que entre otro titular con su botón.
  // Queda en null si el botón se desvincula: la persona no se va del grupo,
  // pero su lugar deja de estar respaldado (ver src/cupos.js).
  seatDeviceId String?

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  seatDevice Device? @relation("CupoDelBoton", fields: [seatDeviceId], references: [id], onDelete: SetNull)

  @@unique([userId, groupId])
  @@index([groupId])
  @@index([seatDeviceId])
}

// El Device Secret nunca se guarda en texto plano: solo su hash.
// El ESP32 se autentica firmando/enviando el secreto y el backend
// lo compara contra secretHash (bcrypt/argon2), nunca al revés.
//
// Un botón existe desde que sale de fábrica, antes de pertenecer a nadie:
// por eso groupId y ownerId son opcionales. Se llenan cuando alguien lo
// vincula desde la app con el claimCode impreso en su caja.
model Device {
  id                String       @id @default(uuid())
  deviceCode        String       @unique
  name              String?
  groupId           String?
  // Quién lo vinculó. En un coto es el vecino dueño de esa casa.
  ownerId           String?
  // El código impreso en la caja. NO cambia al desvincular: el papel de la
  // caja tiene que seguir sirviendo. claimedAt es lo que dice si ya está en
  // uso; mientras sea null, quien tenga la caja lo puede vincular.
  claimCode         String?      @unique
  claimedAt         DateTime?
  secretHash        String
  status            DeviceStatus @default(OFFLINE)
  firmwareVersion   String?
  batteryLevel      Int?
  lastSeenAt        DateTime?
  heartbeatInterval Int          @default(60)
  // Accesos completos comprados. De fábrica un botón solo da funciones
  // completas a sus 2 titulares; cada compra suma 5 lugares que el titular
  // puede repartir entre los invitados de su grupo (ver AccessGrant). Lo
  // mueve un administrador de la plataforma al confirmar el pago.
  extraAccesses     Int          @default(0)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // SetNull y no Cascade: si un grupo se elimina, el botón físico sigue
  // existiendo y se puede volver a vincular; borrar su registro haría
  // inservible el aparato (su secreto no se puede recuperar).
  group          Group?                @relation(fields: [groupId], references: [id], onDelete: SetNull)
  owner          User?                 @relation("DeviceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  holders        DeviceHolder[]
  grants         AccessGrant[]
  solicitudes    PaymentRequest[]
  // Las membresías que ocupan uno de los 10 lugares de este botón.
  seats          GroupMember[]         @relation("CupoDelBoton")
  alerts         Alert[]
  events         DeviceEvent[]
  configurations DeviceConfiguration[]

  @@index([groupId])
}

// Titular de un botón: quien validó el código impreso en su caja. Son como
// máximo DOS por botón, a propósito. La idea del producto: un botón sirve
// para la casa, no para una persona, así que lo comparten los dos que viven
// ahí, y ambos tienen las funciones completas de la app. El resto de la
// familia (que vive en otro lado) entra como invitado: se entera, pero no
// dispara alarmas del coto ajeno.
//
// El tope de 2 se aplica en src/acceso.js, no en la base: la restricción
// "máximo N filas por deviceId" no existe en SQL sin un trigger, y la
// transacción que vincula ya cuenta antes de insertar.
model DeviceHolder {
  id        String   @id @default(uuid())
  deviceId  String
  userId    String
  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // La misma persona no ocupa los dos lugares del mismo botón.
  @@unique([deviceId, userId])
  @@index([userId])
}

// Acceso completo que un titular le da a alguien más, con los lugares que
// compró (Device.extraAccesses). Es lo que convierte a un invitado en una
// cuenta que puede disparar alertas.
//
// Va contra el botón y no contra el titular porque los dos titulares de un
// botón comparten la misma casa y la misma compra.
model AccessGrant {
  id          String   @id @default(uuid())
  deviceId    String
  // Quién recibe el acceso completo.
  userId      String
  // Cuál de los dos titulares lo otorgó (para la bitácora).
  grantedById String
  createdAt   DateTime @default(now())

  device    Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user      User   @relation("AccesoRecibido", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User   @relation("AccesoOtorgado", fields: [grantedById], references: [id], onDelete: Cascade)

  @@unique([deviceId, userId])
  @@index([userId])
}

// Una solicitud de ampliación de límite, de principio a fin: el cliente la
// abre, se le muestran los datos bancarios, deposita, manda UNA captura y un
// administrador la confirma. Al aprobarla se le suman ACCESOS_POR_COMPRA
// lugares completos al botón (Device.extraAccesses).
//
// Es una fila por intento, no una por cliente: si una captura se rechaza
// (borrosa, monto que no cuadra), el cliente abre otra solicitud y manda una
// captura nueva. Con "una captura por cuenta" un error de foto dejaría a
// alguien que ya pagó sin forma de comprobarlo.
model PaymentRequest {
  id           String        @id @default(uuid())
  userId       String
  deviceId     String
  status       PaymentStatus @default(ABIERTA)
  // La captura del pago, guardada aquí mismo. Se eligió la base y no un
  // servicio de archivos porque el proyecto ya tiene Postgres y no hay que
  // pagar ni configurar nada más: un comprobante de celular pesa unos cientos
  // de kilobytes y son unos pocos por cliente.
  //
  // OJO: no la selecciones en las consultas de lista. Solo la lee la ruta que
  // se la sirve al administrador; traerla de más carga megabytes a memoria sin
  // que nadie los use.
  proofImage   Bytes?
  // El tipo de la imagen (image/jpeg, image/png...). Sirve para servirla con
  // la cabecera correcta y, de paso, para saber si ya hay comprobante sin
  // tener que leer los bytes.
  proofType    String?
  proofAt      DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  // Por qué se rechazó, para que el cliente sepa qué corregir.
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User             @relation("SolicitanteDelPago", fields: [userId], references: [id], onDelete: Cascade)
  device     Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  reviewedBy User?            @relation("RevisorDelPago", fields: [reviewedById], references: [id], onDelete: SetNull)
  messages   PaymentMessage[]

  @@index([status, createdAt])
  @@index([userId])
}

// El chat de la solicitud. El cliente NO escribe texto libre: manda mensajes
// de un catálogo cerrado (src/pagos.js) y el backend resuelve el texto. Así
// el hilo es predecible, no hay nada que moderar y el cliente no puede
// escribir datos sensibles donde no van.
model PaymentMessage {
  id        String        @id @default(uuid())
  requestId String
  from      PaymentAuthor
  // Id del mensaje del catálogo (YA_PAGUE, CUANTO_TARDA...) o TEXTO cuando
  // lo escribe soporte.
  kind      String
  body      String
  // Quién lo mandó. Null cuando es un mensaje automático de la plataforma.
  userId    String?
  createdAt DateTime      @default(now())

  request PaymentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

// Bitácora cruda de todo lo que manda el dispositivo (heartbeat, panic,
// cambios de estado). Sirve para diagnóstico e historial sin inflar Device.
model DeviceEvent {
  id        String          @id @default(uuid())
  deviceId  String
  type      DeviceEventType
  payload   Json?
  createdAt DateTime        @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
}

model DeviceConfiguration {
  id        String   @id @default(uuid())
  deviceId  String
  key       String
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, key])
}

model Alert {
  id             String      @id @default(uuid())
  groupId        String
  deviceId       String?
  source         AlertSource
  // Qué está pasando (CARRO_SOSPECHOSO, INCENDIO, ...). Es String y no enum
  // a propósito: el catálogo vive en src/tiposAlerta.js y cambiarlo no debe
  // requerir una migración. El botón físico siempre manda GENERAL.
  type           String      @default("GENERAL")
  status         AlertStatus @default(ACTIVE)
  createdById    String?
  createdAt      DateTime    @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([groupId, createdAt])
}

model Notification {
  id        String             @id @default(uuid())
  alertId   String
  userId    String
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Token de FCM de un navegador/instalación concreta de la PWA. Una persona
// puede traer la app en el celular y en la compu, y cada una tiene su propio
// token, así que esto es una tabla aparte y no una columna de User. El token
// es único: si reaparece bajo otra cuenta (celular compartido) se reasigna al
// nuevo dueño en vez de duplicarse.
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}
