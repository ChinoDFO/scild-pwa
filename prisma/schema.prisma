// Modelo de datos del backend de SCILD Emergencia.
// Users/Groups/Devices/Alerts/Messages/Notifications/DeviceEvents/
// DeviceConfigurations/AuditLogs, tal como se definió en la propuesta técnica.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum DeviceStatus {
  ONLINE
  IRREGULAR
  OFFLINE
  EMERGENCY
  MAINTENANCE
}

enum AlertSource {
  DEVICE
  APP
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum DeviceEventType {
  HEARTBEAT
  PANIC
  STATUS_CHANGE
  CONFIG_UPDATE
  CONNECTED
  DISCONNECTED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// La identidad y la contraseña viven en Firebase Auth. Este modelo solo
// guarda el perfil y enlaza con Firebase mediante firebaseUid.
model User {
  id              String   @id @default(uuid())
  firebaseUid     String   @unique
  email           String   @unique
  displayName     String?
  phone           String?
  // Administrador de la plataforma (nosotros), no de un grupo. Es quien ve
  // la lista de solicitudes de pago y confirma los depósitos. Se prende a
  // mano en la base: no hay forma de dárselo a sí mismo desde la app.
  isPlatformAdmin Boolean  @default(false)
  // Cuándo aceptó la versión vigente de los Términos y Condiciones / Aviso de
  // Privacidad. Null = todavía no los ha aceptado (cuenta nueva, o cuenta
  // vieja de antes de que existiera esta pantalla). La app bloquea el uso
  // hasta que se acepta.
  termsAcceptedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships   GroupMember[]
  devices       Device[]       @relation("DeviceOwner")
  // Botones de los que es titular (el código de la caja se valida 2 veces).
  titularidades DeviceHolder[]
  messages      Message[]
  alertsCreated Alert[]        @relation("AlertCreatedBy")
  notifications Notification[]
  pushTokens    PushToken[]
  auditLogs     AuditLog[]

  @@index([email])
}

model Group {
  id         String   @id @default(uuid())
  name       String
  address    String?
  latitude   Float?
  longitude  Float?
  // Cuánta gente cabe. Lo edita el administrador del grupo hasta MAX_MIEMBROS
  // (50). Antes salía de los botones vinculados —cada uno daba diez lugares—,
  // pero eso ataba el tamaño del grupo a cuántos aparatos había dentro, que
  // son dos cosas sin relación.
  maxMembers Int @default(10)
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members  GroupMember[]
  // Los botones que le avisan a este grupo (la tabla intermedia: un botón
  // puede avisarle a varios grupos, ver DeviceGroup).
  devices  DeviceGroup[]
  alerts   Alert[]
  messages Message[]
}

model GroupMember {
  id           String   @id @default(uuid())
  userId       String
  groupId      String
  role         Role     @default(MEMBER)
  joinedAt     DateTime @default(now())
  // Hasta dónde leyó el chat de este grupo. Con esto se sabe cuántos
  // mensajes trae sin leer y si el aviso push dice el mensaje o
  // "3 mensajes nuevos".
  lastReadAt   DateTime @default(now())
  // Grupo fijado arriba en la lista. Es de cada quien, no del grupo: el
  // vecino que atiende el coto quiere ese chat siempre a la mano, y a los
  // demás no se les mueve nada. Guarda CUÁNDO se fijó para poder ordenar
  // entre varios fijados (el último que se fija queda hasta arriba).
  pinnedAt     DateTime?

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

// El Device Secret nunca se guarda en texto plano: solo su hash.
// El ESP32 se autentica firmando/enviando el secreto y el backend
// lo compara contra secretHash (bcrypt/argon2), nunca al revés.
//
// Un botón existe desde que sale de fábrica, antes de pertenecer a nadie:
// por eso ownerId es opcional y no tiene ningún grupo (DeviceGroup). Se llenan
// cuando alguien lo vincula desde la app con el claimCode impreso en su caja.
model Device {
  id                String       @id @default(uuid())
  deviceCode        String       @unique
  name              String?
  // Quién lo vinculó. En un coto es el vecino dueño de esa casa.
  ownerId           String?
  // El código impreso en la caja. NO cambia al desvincular: el papel de la
  // caja tiene que seguir sirviendo. claimedAt es lo que dice si ya está en
  // uso; mientras sea null, quien tenga la caja lo puede vincular.
  claimCode         String?      @unique
  claimedAt         DateTime?
  secretHash        String
  status            DeviceStatus @default(OFFLINE)
  firmwareVersion   String?
  batteryLevel      Int?
  lastSeenAt        DateTime?
  heartbeatInterval Int          @default(60)
  // Telemetría del último heartbeat. Es lo que la app enseña en la pantalla
  // del botón (red activa, IP, señal, fallos) y lo que permite distinguir
  // "no llega señal" de "llega pero con el WiFi en las últimas". Se guarda el
  // último valor en Device —es lo que se consulta— y el histórico crudo
  // queda en DeviceEvent.
  ipAddress         String?
  ssid              String?
  // dBm: -55 o mejor es excelente, -70 aceptable, por debajo es débil.
  rssi              Int?
  // Cuántas veces seguidas el aparato se quedó sin internet teniendo WiFi.
  internetFailures  Int          @default(0)
  // Alguien pidió desde la app que el botón olvide su red Wi-Fi principal y
  // vuelva a abrir su portal (reemplaza dejarlo presionado al encenderlo,
  // que además borraba su identidad). Se entrega en el siguiente
  // heartbeat/status y se limpia ahí mismo: es un mandado de una sola vez,
  // no un ajuste persistente como DeviceConfiguration.
  wifiResetRequestedAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  owner          User?                 @relation("DeviceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // A qué grupos les avisa (hasta GRUPOS_POR_BOTON, ver src/acceso.js).
  groups         DeviceGroup[]
  holders        DeviceHolder[]
  alerts         Alert[]
  events         DeviceEvent[]
  configurations DeviceConfiguration[]
}

// A qué grupos les avisa un botón. Antes era una sola columna en Device, y
// por eso un botón solo podía avisarle a un grupo; ahora son hasta tres
// (GRUPOS_POR_BOTON en src/acceso.js): un negocio que atiende a su cuadra y a
// la asociación de comerciantes, una casa que avisa a la familia y al coto.
//
// Cascade por los dos lados, y es a propósito: si un grupo se elimina, su
// vínculo se va con él pero el botón físico sigue existiendo y se puede volver
// a vincular. Borrar el registro del aparato lo dejaría inservible (su secreto
// no se puede recuperar) y aquí solo se borra la fila del vínculo.
//
// createdAt manda el orden: el grupo más antiguo es el "principal", el que da
// nombre y dirección al aparato (lo que muestra por el puerto serie).
model DeviceGroup {
  id        String   @id @default(uuid())
  deviceId  String
  groupId   String
  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // El mismo botón no ocupa dos veces el mismo grupo.
  @@unique([deviceId, groupId])
  @@index([groupId])
}

// Titular de un botón: quien validó el código impreso en su caja. Son como
// máximo DOS por botón, a propósito. La idea del producto: un botón sirve
// para la casa, no para una persona, así que lo comparten los dos que viven
// ahí, y ambos tienen las funciones completas de la app. El resto de la
// familia (que vive en otro lado) entra como invitado: se entera, pero no
// dispara alarmas del coto ajeno.
//
// Son los únicos con funciones completas: al quitarse los accesos
// comprados, ser titular es la única forma de poder disparar alertas.
//
// El tope de 2 se aplica en src/acceso.js, no en la base: la restricción
// "máximo N filas por deviceId" no existe en SQL sin un trigger, y la
// transacción que vincula ya cuenta antes de insertar.
model DeviceHolder {
  id        String   @id @default(uuid())
  deviceId  String
  userId    String
  createdAt DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // La misma persona no ocupa los dos lugares del mismo botón.
  @@unique([deviceId, userId])
  @@index([userId])
}

// Bitácora cruda de todo lo que manda el dispositivo (heartbeat, panic,
// cambios de estado). Sirve para diagnóstico e historial sin inflar Device.
model DeviceEvent {
  id        String          @id @default(uuid())
  deviceId  String
  type      DeviceEventType
  payload   Json?
  createdAt DateTime        @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
}

// Ajustes que la app le manda al botón sin tocar el aparato. El ESP32 los
// baja en la respuesta del heartbeat y los guarda en su memoria (Preferences),
// así que sobreviven a un reinicio aunque se quede sin internet.
//
// Llave/valor y no columnas: el firmware gana ajustes con el tiempo y cada
// uno no puede costar una migración. Las que entiende el firmware v8 están
// listadas en src/configuracionBoton.js.
model DeviceConfiguration {
  id        String   @id @default(uuid())
  deviceId  String
  key       String
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, key])
}

model Alert {
  id             String      @id @default(uuid())
  groupId        String
  deviceId       String?
  source         AlertSource
  // Qué está pasando (CARRO_SOSPECHOSO, INCENDIO, ...). Es String y no enum
  // a propósito: el catálogo vive en src/tiposAlerta.js y cambiarlo no debe
  // requerir una migración. El botón físico siempre manda GENERAL.
  type           String      @default("GENERAL")
  status         AlertStatus @default(ACTIVE)
  createdById    String?
  createdAt      DateTime    @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  // Último "sigue presionado" que se mandó mientras esta alerta seguía
  // ACTIVE. Null hasta el primero, que se manda a los 15 min de createdAt.
  lastReminderAt DateTime?

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([groupId, createdAt])
}

model Notification {
  id        String             @id @default(uuid())
  alertId   String
  userId    String
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Token de FCM de un navegador/instalación concreta de la PWA. Una persona
// puede traer la app en el celular y en la compu, y cada una tiene su propio
// token, así que esto es una tabla aparte y no una columna de User. El token
// es único: si reaparece bajo otra cuenta (celular compartido) se reasigna al
// nuevo dueño en vez de duplicarse.
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  // Para la limpieza diaria (ver src/limpieza.js): borra por antigüedad sin
  // importar el grupo, así que el índice de arriba (que arranca en groupId)
  // no le sirve de nada a ese filtro.
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}
