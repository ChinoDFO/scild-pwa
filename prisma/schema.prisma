// Modelo de datos del backend de SCILD Emergencia.
// Users/Groups/Devices/Alerts/Messages/Notifications/DeviceEvents/
// DeviceConfigurations/AuditLogs, tal como se definió en la propuesta técnica.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum DeviceStatus {
  ONLINE
  IRREGULAR
  OFFLINE
  EMERGENCY
  MAINTENANCE
}

enum AlertSource {
  DEVICE
  APP
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum DeviceEventType {
  HEARTBEAT
  PANIC
  STATUS_CHANGE
  CONFIG_UPDATE
  CONNECTED
  DISCONNECTED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// La identidad y la contraseña viven en Firebase Auth. Este modelo solo
// guarda el perfil y enlaza con Firebase mediante firebaseUid.
model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique
  email       String   @unique
  displayName String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships       GroupMember[]
  devices           Device[]       @relation("DeviceOwner")
  messages          Message[]
  alertsCreated     Alert[]        @relation("AlertCreatedBy")
  notifications     Notification[]
  pushTokens        PushToken[]
  auditLogs         AuditLog[]

  @@index([email])
}

model Group {
  id         String   @id @default(uuid())
  name       String
  address    String?
  latitude   Float?
  longitude  Float?
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members  GroupMember[]
  devices  Device[]
  alerts   Alert[]
  messages Message[]
}

model GroupMember {
  id       String   @id @default(uuid())
  userId   String
  groupId  String
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())
  // Hasta dónde leyó el chat de este grupo. Con esto se sabe cuántos
  // mensajes trae sin leer y si el aviso push dice el mensaje o
  // "3 mensajes nuevos".
  lastReadAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

// El Device Secret nunca se guarda en texto plano: solo su hash.
// El ESP32 se autentica firmando/enviando el secreto y el backend
// lo compara contra secretHash (bcrypt/argon2), nunca al revés.
//
// Un botón existe desde que sale de fábrica, antes de pertenecer a nadie:
// por eso groupId y ownerId son opcionales. Se llenan cuando alguien lo
// vincula desde la app con el claimCode impreso en su caja.
model Device {
  id                String       @id @default(uuid())
  deviceCode        String       @unique
  name              String?
  groupId           String?
  // Quién lo vinculó. En un coto es el vecino dueño de esa casa.
  ownerId           String?
  // El código impreso en la caja. NO cambia al desvincular: el papel de la
  // caja tiene que seguir sirviendo. claimedAt es lo que dice si ya está en
  // uso; mientras sea null, quien tenga la caja lo puede vincular.
  claimCode         String?      @unique
  claimedAt         DateTime?
  secretHash        String
  status            DeviceStatus @default(OFFLINE)
  firmwareVersion   String?
  batteryLevel      Int?
  lastSeenAt        DateTime?
  heartbeatInterval Int          @default(60)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // SetNull y no Cascade: si un grupo se elimina, el botón físico sigue
  // existiendo y se puede volver a vincular; borrar su registro haría
  // inservible el aparato (su secreto no se puede recuperar).
  group          Group?                @relation(fields: [groupId], references: [id], onDelete: SetNull)
  owner          User?                 @relation("DeviceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  alerts         Alert[]
  events         DeviceEvent[]
  configurations DeviceConfiguration[]

  @@index([groupId])
}

// Bitácora cruda de todo lo que manda el dispositivo (heartbeat, panic,
// cambios de estado). Sirve para diagnóstico e historial sin inflar Device.
model DeviceEvent {
  id        String          @id @default(uuid())
  deviceId  String
  type      DeviceEventType
  payload   Json?
  createdAt DateTime        @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
}

model DeviceConfiguration {
  id        String   @id @default(uuid())
  deviceId  String
  key       String
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, key])
}

model Alert {
  id             String      @id @default(uuid())
  groupId        String
  deviceId       String?
  source         AlertSource
  // Qué está pasando (CARRO_SOSPECHOSO, INCENDIO, ...). Es String y no enum
  // a propósito: el catálogo vive en src/tiposAlerta.js y cambiarlo no debe
  // requerir una migración. El botón físico siempre manda GENERAL.
  type           String      @default("GENERAL")
  status         AlertStatus @default(ACTIVE)
  createdById    String?
  createdAt      DateTime    @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("AlertCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@index([groupId, createdAt])
}

model Notification {
  id        String             @id @default(uuid())
  alertId   String
  userId    String
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Token de FCM de un navegador/instalación concreta de la PWA. Una persona
// puede traer la app en el celular y en la compu, y cada una tiene su propio
// token, así que esto es una tabla aparte y no una columna de User. El token
// es único: si reaparece bajo otra cuenta (celular compartido) se reasigna al
// nuevo dueño en vez de duplicarse.
model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Message {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  content   String
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}
